{
  "manifest_version": 3,
  "name": "Garmin to ZWO Converter",
  "version": "1.0.0",
  "description": "Convert Garmin Connect workouts to ZWO format. This extension does not collect any personal data.",
  "browser_specific_settings": {
    "gecko": {
      "id": "garmin-zwo-converter-extension@jonaszuercher.ch",
      "data_collection_permissions": {
      "required": ["none"]
    }
    }
  },
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "*://connect.garmin.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://connect.garmin.com/app/workout/*"],
      "js": ["content.js"],
      "css": ["styles.css"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
